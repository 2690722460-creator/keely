# Local development only: copy to .env.local. Keep real credentials out of ZIP/Git.
# Deployment: set the same variables in Vercel Environment Variables instead.
HOST=127.0.0.1
PORT=4180

# QQ Mail: enable SMTP in the mailbox settings, then use its SMTP authorization
# code below (not the QQ account password). Use the full sending mailbox address.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Server-owned recipient; visitors never choose the recipient or sender.
# Sender address always comes from SMTP_USER. A valid visitor email is Reply-To.
CONTACT_TO=2690722460@qq.com

# Exact browser origins, comma-separated. No paths, wildcard, or "null".
# For a custom deployment domain replace/add its https:// origin here.
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL are read from trusted platform env.
APP_ORIGIN=http://localhost:4180,http://127.0.0.1:4180

# Port 587 uses SMTP_SECURE=false, with mandatory STARTTLS enforced by code.
# Certificate verification is always enabled; there is no insecure TLS switch.
# Optional auth verification at CLI startup; failure never blocks the static page.
SMTP_VERIFY_ON_START=false

# Default: use the TCP peer, ignore X-Forwarded-For. Enable only behind a proxy
# that overwrites the forwarded header (e.g. a correctly configured deployment).
# The 5 requests / 15 min limiter is in-memory, per process/Vercel instance.
TRUST_PROXY=false

# Portfolio CMS — server environment only. Run supabase SQL and create admin user first.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER_ID=
SUPABASE_STORAGE_BUCKET=portfolio-media
